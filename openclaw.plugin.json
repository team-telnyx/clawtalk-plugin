{
    "id": "clawtalk",
    "name": "ClawTalk",
  "description": "Voice calls, SMS, missions, and approvals via ClawTalk",
  "activation": {
    "onStartup": true,
    "onConfigPaths": [
      "plugins.entries.clawtalk"
    ]
  },
  "contracts": {
    "tools": [
      "clawtalk_bot_config",
      "clawtalk_call",
      "clawtalk_call_status",
      "clawtalk_sms",
      "clawtalk_sms_list",
      "clawtalk_sms_conversations",
      "clawtalk_approve",
      "clawtalk_status",
      "clawtalk_mission_init",
      "clawtalk_mission_setup_agent",
      "clawtalk_mission_schedule",
      "clawtalk_mission_event_status",
      "clawtalk_mission_complete",
      "clawtalk_mission_update_step",
      "clawtalk_mission_log_event",
      "clawtalk_mission_memory",
      "clawtalk_mission_list",
      "clawtalk_mission_get_plan",
      "clawtalk_mission_cancel_event",
      "clawtalk_assistants",
      "clawtalk_insights"
    ]
  },
  "skills": [
    "./skills"
  ],
    "configSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
            "enabled": {
                "type": "boolean"
            },
            "apiKey": {
                "type": "string",
                "description": "ClawTalk API key"
            },
            "server": {
                "type": "string",
                "description": "ClawTalk server URL",
                "default": "https://clawdtalk.com"
            },
            "ownerName": {
                "type": "string",
                "description": "User's name for voice greeting"
            },
            "agentName": {
                "type": "string",
                "description": "Agent's name for voice context"
            },
            "greeting": {
                "type": "string",
                "description": "Custom greeting for inbound calls"
            },
            "agentId": {
                "type": "string",
                "description": "Gateway agent ID",
                "default": "main"
            },
            "autoConnect": {
                "type": "boolean",
                "description": "Connect WebSocket on startup",
                "default": true
            },
            "voiceContext": {
                "type": "string",
                "description": "Override default voice context prompt"
            },
            "missions": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "enabled": {
                        "type": "boolean",
                        "default": true
                    },
                    "defaultVoice": {
                        "type": "string",
                        "description": "Default TTS voice for mission assistants"
                    },
                    "defaultModel": {
                        "type": "string",
                        "description": "Default AI model for mission assistants"
                    },
                    "observer": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "enabled": {
                                "type": "boolean",
                                "default": true
                            },
                            "intervalMs": {
                                "type": "number",
                                "description": "Mission observer interval (ms)",
                                "default": 300000
                            },
                            "cooldownMs": {
                                "type": "number",
                                "description": "Cooldown between prompts for the same mission (ms)",
                                "default": 300000
                            }
                        }
                    }
                }
            }
        }
    },
    "uiHints": {
        "apiKey": {
            "label": "API Key",
            "sensitive": true
        },
        "server": {
            "label": "Server URL",
            "placeholder": "https://clawdtalk.com",
            "advanced": true
        },
        "ownerName": {
            "label": "Your Name"
        },
        "agentName": {
            "label": "Agent Name"
        },
        "greeting": {
            "label": "Greeting",
            "advanced": true
        },
        "agentId": {
            "label": "Agent ID",
            "advanced": true
        },
        "autoConnect": {
            "label": "Auto-Connect WebSocket",
            "advanced": true
        },
        "voiceContext": {
            "label": "Voice Context Prompt",
            "advanced": true
        },
        "missions.enabled": {
            "label": "Enable Missions"
        },
        "missions.defaultVoice": {
            "label": "Default Voice",
            "advanced": true
        },
        "missions.defaultModel": {
            "label": "Default Model",
            "advanced": true
        },
        "missions.observer.enabled": {
            "label": "Enable Mission Observer",
            "advanced": true
        },
        "missions.observer.intervalMs": {
            "label": "Mission Observer Interval (ms)",
            "advanced": true
        },
        "missions.observer.staleThresholdMs": {
            "label": "Mission Stale Threshold (ms)",
            "advanced": true
        },
        "missions.observer.cooldowns.pendingCallsMs": {
            "label": "Pending Call Cooldown (ms)",
            "advanced": true
        },
        "missions.observer.cooldowns.staleMs": {
            "label": "Stale Mission Cooldown (ms)",
            "advanced": true
        },
        "missions.observer.cooldowns.terminalPlanMs": {
            "label": "Terminal Plan Cooldown (ms)",
            "advanced": true
        }
    }
}
